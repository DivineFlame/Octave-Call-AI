# Copy these into the Dokploy Compose Environment editor.
# Dokploy writes them to .env next to docker-compose.dokploy.yaml.

# Public domains configured in Dokploy's Domains tab.
UI_APP_URL=https://app.example.com
BACKEND_API_ENDPOINT=https://api.example.com
MINIO_PUBLIC_ENDPOINT=https://storage.example.com
TURN_HOST=turn.example.com

# Images.
REGISTRY=divineflame
IMAGE_TAG=latest

# Core secrets. Generate fresh values before deploying.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=octave
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
OSS_JWT_SECRET=replace-with-a-long-random-secret
TURN_SECRET=replace-with-a-long-random-secret

# Runtime mode.
ENVIRONMENT=production
DEPLOYMENT_MODE=oss
AUTH_PROVIDER=local
ENABLE_TELEMETRY=false
FORCE_TURN_RELAY=false
FASTAPI_WORKERS=1

# Existing Octave CRM Ollama container.
# Set this to the Docker network where the Octave CRM Ollama container is
# attached. Only the Octave-Call-AI API container joins this network.
# The Ollama container must be reachable on this network with alias/name "ollama".
SHARED_DOCKER_NETWORK=octave-ai-network

# Configure Octave-Call-AI to use the existing CRM Ollama service:
# Configure Octave-Call-AI with provider OpenAI:
#   base_url=http://ollama:11434/v1
#   api_key=ollama
#   model=llama3.1
# For local Knowledge Base chunked search, configure Embedding provider Ollama:
#   base_url=http://ollama:11434/v1
#   api_key=ollama
#   model=rjmalagon/gte-qwen2-1.5b-instruct-embed-f16

# Optional managed-platform/tracing settings.
MPS_API_URL=https://services.octave-call-ai.com
OCTAVE_CALL_AI_MPS_SECRET_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
